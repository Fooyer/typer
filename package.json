{
  "name": "typer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && tsc -p tsconfig.electron.json && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.8",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "opencode-ai": "^1.18.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.15.1",
  "build": {
    "appId": "com.typer.app",
    "productName": "typer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/mcp/**/*"
    ],
    "win": {
      "icon": "public/icon.ico"
    },
    "linux": {
      "icon": "public/favicon.svg"
    }
  }
}
